NODE_ENV=development
APP_NAME=ts-business-app-starter
APP_VERSION=development
API_HOST=0.0.0.0
API_PORT=8090
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_WEB_URL=http://localhost:5174
POSTGRES_PORT=5438
DATABASE_URL=postgres://app:app_password@localhost:5438/app
API_DOCS_ENABLED=true
AUTH_SESSION_TTL_SECONDS=604800
AUTH_ACTION_TOKEN_TTL_SECONDS=3600
AUTH_COOKIE_NAME=app_session
AUTH_CSRF_COOKIE_NAME=app_csrf
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_EXPOSE_TEST_TOKENS=true
# JSON keyring. Keep old entries while rotating encrypted settings; never commit production keys.
SETTINGS_ENCRYPTION_CURRENT_KEY_ID=development
SETTINGS_ENCRYPTION_KEYS={"development":"development-only-settings-key-change-me"}
# Optional database-overridable setting fallbacks.
SUPPORT_EMAIL=
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# PostgreSQL-backed worker tuning; worker identities are generated per process.
JOB_POLL_INTERVAL_MS=500
JOB_BATCH_SIZE=20
JOB_LOCK_TIMEOUT_SECONDS=60
JOB_HEARTBEAT_INTERVAL_MS=10000
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=300000
# Object storage. `s3` supports AWS S3 and compatible endpoints such as R2, MinIO and Qiniu Kodo.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.data/storage
STORAGE_MAX_UPLOAD_BYTES=25000000
STORAGE_UPLOAD_EXPIRY_SECONDS=900
STORAGE_ACCESS_EXPIRY_SECONDS=900
STORAGE_ALLOWED_MIME_TYPES=image/*,application/pdf,text/plain
STORAGE_ALLOWED_PREFIXES=media,documents,avatars
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=
# Payments. `mock` is accepted only outside production; production should use Alipay or WeChat Pay.
PAYMENT_PROVIDER=mock
PAYMENT_NOTIFY_BASE_URL=http://localhost:8090
PAYMENT_CALLBACK_TOLERANCE_SECONDS=300
PAYMENT_ALIPAY_APP_ID=
PAYMENT_ALIPAY_PRIVATE_KEY=
PAYMENT_ALIPAY_PUBLIC_KEY=
PAYMENT_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
PAYMENT_ALIPAY_RETURN_URL=http://localhost:5174/payments/return
PAYMENT_WECHAT_MCH_ID=
PAYMENT_WECHAT_APP_ID=
PAYMENT_WECHAT_MERCHANT_SERIAL=
PAYMENT_WECHAT_PRIVATE_KEY=
PAYMENT_WECHAT_PLATFORM_CERTIFICATES=
PAYMENT_WECHAT_API_V3_KEY=
# Used only by `pnpm db:bootstrap`; remove these values after the first owner is created.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-at-least-12-characters
