{
  "name": "@ts-business-app-starter/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Validated browser API client and React Query integration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lingcoo-tech/http": "0.1.1",
    "@tanstack/react-query": "5.102.8",
    "@ts-business-app-starter/contracts": "workspace:*",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
