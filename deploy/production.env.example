NODE_ENV=production
APP_NAME=ts-business-app-starter
APP_VERSION=replace-with-git-sha
CORS_ORIGIN=https://your-domain.example.com
PUBLIC_WEB_URL=https://your-domain.example.com
API_DOCS_ENABLED=false
AUTH_SESSION_TTL_SECONDS=604800
AUTH_ACTION_TOKEN_TTL_SECONDS=3600
AUTH_COOKIE_NAME=__Host-app_session
AUTH_CSRF_COOKIE_NAME=__Host-app_csrf
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=true
AUTH_EXPOSE_TEST_TOKENS=false
SETTINGS_ENCRYPTION_CURRENT_KEY_ID=production-v1
SETTINGS_ENCRYPTION_KEYS={"production-v1":"replace-with-at-least-32-random-characters"}
# Optional database-overridable setting fallbacks.
SUPPORT_EMAIL=
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
JOB_POLL_INTERVAL_MS=500
JOB_BATCH_SIZE=20
JOB_LOCK_TIMEOUT_SECONDS=60
JOB_HEARTBEAT_INTERVAL_MS=10000
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=300000
# Used by the explicit bootstrap command. Remove after the initial owner is created.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-long-random-password

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-random-value
DATABASE_URL=postgres://app:replace-with-a-random-value@postgres:5432/app

APP_IMAGE=replace-with-registry/app:git-sha
HTTP_PORT=18093
CADDY_SITE_ADDRESS=:80
