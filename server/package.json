{
  "name": "@ts-business-app-starter/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:bootstrap": "nest build && node dist/bootstrap.js",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1117.0",
    "@aws-sdk/s3-request-presigner": "3.1117.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "9.2.1",
    "@fastify/static": "10.1.3",
    "@lingcoo-tech/crypto": "0.1.1",
    "@lingcoo-tech/http": "0.1.1",
    "@lingcoo-tech/mailer": "0.1.1",
    "@lingcoo-tech/security": "0.1.1",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@ts-business-app-starter/contracts": "workspace:*",
    "alipay-sdk": "4.14.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "fastify-raw-body": "6.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "wechatpay-axios-plugin": "0.9.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.1",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
